<style>
  .contact-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 5%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    align-items: start;
  }

  /* --- Colonne Gauche : Informations --- */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .contact-info__title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 900;
    color: #000;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -1px;
    line-height: 1.1;
  }

  .contact-info__desc {
    font-size: 1.1rem;
    color: #555;
    line-height: 1.6;
    margin: 0;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 10px;
  }

  .contact-detail-item {
    display: flex;
    align-items: flex-start;
    gap: 15px;
  }

  .contact-detail-item svg {
    width: 24px;
    height: 24px;
    fill: #000;
    flex-shrink: 0;
  }

  .contact-detail-text {
    display: flex;
    flex-direction: column;
  }

  .contact-detail-text strong {
    font-size: 1.1rem;
    color: #000;
    margin-bottom: 5px;
  }

  .contact-detail-text span, 
  .contact-detail-text a {
    font-size: 1rem;
    color: #666;
    text-decoration: none;
    transition: color 0.2s;
  }

  .contact-detail-text a:hover {
    color: #000;
    text-decoration: underline;
  }

  /* --- Colonne Droite : Formulaire --- */
  .contact-form-wrapper {
    background-color: #f9f9f9;
    padding: 50px;
    border-radius: 24px;
    border: 1px solid #eee;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact-form__field label {
    font-size: 0.95rem;
    font-weight: 700;
    color: #000;
  }

  .contact-form__input,
  .contact-form__textarea {
    width: 100%;
    padding: 15px 20px;
    border: 1px solid #ddd;
    border-radius: 12px;
    font-size: 1rem;
    font-family: inherit;
    background-color: #fff;
    outline: none;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .contact-form__input:focus,
  .contact-form__textarea:focus {
    border-color: #000;
    box-shadow: 0 0 0 1px #000;
  }

  .contact-form__textarea {
    resize: vertical;
    min-height: 150px;
  }

  .contact-form__btn {
    background-color: #000;
    color: #fff;
    border: none;
    padding: 18px 30px;
    font-size: 1.1rem;
    font-weight: 800;
    border-radius: 50px;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: transform 0.2s, background-color 0.2s;
    margin-top: 10px;
  }

  .contact-form__btn:hover {
    background-color: #333;
    transform: translateY(-2px);
  }

  /* --- Messages de succès et d'erreur --- */
  .contact-form__success {
    background-color: #d4edda;
    color: #155724;
    padding: 15px 20px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-weight: 600;
    border: 1px solid #c3e6cb;
  }

  .contact-form__error {
    background-color: #f8d7da;
    color: #721c24;
    padding: 15px 20px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-weight: 600;
    border: 1px solid #f5c6cb;
  }
  .contact-form__error ul {
    margin: 5px 0 0 20px;
    padding: 0;
  }

  /* --- Responsive --- */
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .contact-form-wrapper {
      padding: 30px 20px;
    }
  }

  @media (max-width: 600px) {
    .contact-form__row {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="contact-page">
  <div class="contact-grid">
    
    <div class="contact-info">
      <h1 class="contact-info__title">{{ page.title | escape }}</h1>
      <div class="contact-info__desc">
        {{ page.content }}
      </div>
      
      <div class="contact-details">
        {%- if section.settings.email != blank -%}
          <div class="contact-detail-item">
            <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            <div class="contact-detail-text">
              <strong>Email</strong>
              <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.phone != blank -%}
          <div class="contact-detail-item">
            <svg viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            <div class="contact-detail-text">
              <strong>Téléphone</strong>
              <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.hours != blank -%}
          <div class="contact-detail-item">
            <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            <div class="contact-detail-text">
              <strong>Horaires</strong>
              <span>{{ section.settings.hours }}</span>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="contact-form-wrapper">
      {% form 'contact', class: 'contact-form' %}
        
        {%- if form.posted_successfully? -%}
          <div class="contact-form__success" tabindex="-1" autofocus>
            Merci de nous avoir contactés ! Nous vous répondrons dans les plus brefs délais.
          </div>
        {%- elsif form.errors -%}
          <div class="contact-form__error">
            Une erreur est survenue lors de l'envoi de votre message :
            <ul>
              {%- for field in form.errors -%}
                <li>Le champ <b>{{ field | capitalize }}</b> {{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="ContactForm-name">Nom complet</label>
            <input type="text" id="ContactForm-name" name="contact[name]" class="contact-form__input" value="{{ form.name | default: customer.name }}" placeholder="Jean Dupont" required>
          </div>
          <div class="contact-form__field">
            <label for="ContactForm-email">E-mail</label>
            <input type="email" id="ContactForm-email" name="contact[email]" class="contact-form__input" value="{{ form.email | default: customer.email }}" placeholder="jean@exemple.com" required>
          </div>
        </div>

        <div class="contact-form__field">
          <label for="ContactForm-phone">Téléphone (Optionnel)</label>
          <input type="tel" id="ContactForm-phone" name="contact[phone]" class="contact-form__input" value="{{ form.phone | default: customer.phone }}" placeholder="+33 6 12 34 56 78">
        </div>

        <div class="contact-form__field">
          <label for="ContactForm-body">Votre message</label>
          <textarea id="ContactForm-body" name="contact[body]" class="contact-form__textarea" placeholder="Comment pouvons-nous vous aider ?" required>{{ form.body }}</textarea>
        </div>

        <button type="submit" class="contact-form__btn">Envoyer le message</button>

      {% endform %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Page de Contact",
  "settings": [
    {
      "type": "header",
      "content": "Informations de contact"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Adresse E-mail",
      "default": "hello@maboutique.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Numéro de téléphone",
      "default": "+33 1 23 45 67 89"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Horaires d'ouverture",
      "default": "Lundi - Vendredi : 9h00 - 18h00\nSamedi : 10h00 - 15h00"
    }
  ]
}
{% endschema %}