{% layout none %}
<style>
  /* --- Conteneur Principal --- */
  .fashion-slider-{{ section.id }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.desktop_height }}vh;
    min-height: 550px;
    overflow: hidden;
    background-color: #000;
  }

  /* --- Diapositive (Slide) --- */
  .fashion-slide {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    opacity: 0; visibility: hidden;
    transition: opacity 1.2s ease-in-out, visibility 1.2s ease-in-out;
    z-index: 1;
  }
  .fashion-slide.is-active {
    opacity: 1; visibility: visible; z-index: 2;
  }

  /* --- Images avec zoom lent --- */
  .fashion-slide__img {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    transition: transform 6s linear;
  }
  .fashion-slide.is-active .fashion-slide__img { transform: scale(1); }
  .fashion-slide__img--mobile { display: none; }

  /* --- Overlay --- */
  .fashion-slide__overlay {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    background: #000; z-index: 2;
  }

  /* --- Conteneur du Texte --- */
  .fashion-content {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    z-index: 3; text-align: center;
    width: 90%; max-width: 900px; color: #fff;
  }

  /* Animations de base */
  .fashion-title, .fashion-text, .fashion-btn {
    opacity: 0;
    transform: translateY(30px);
  }
  .fashion-slide.is-active .fashion-title { transition: all 0.8s ease-out 0.3s; opacity: 1; transform: translateY(0); }
  .fashion-slide.is-active .fashion-text { transition: all 0.8s ease-out 0.5s; opacity: 1; transform: translateY(0); }
  .fashion-slide.is-active .fashion-btn { transition: all 0.8s ease-out 0.7s, background-color 0.3s, color 0.3s; opacity: 1; transform: translateY(0); }

  /* =========================================
     LES 5 STYLES TYPOGRAPHIQUES
  ========================================= */

  /* 1. Style : MODERN CLEAN (Par défaut) */
  .style--modern .fashion-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -1px;
    margin-bottom: 20px;
    line-height: 1.1;
  }
  .style--modern .fashion-text {
    font-family: inherit; font-size: clamp(1rem, 1.5vw, 1.2rem); margin-bottom: 30px;
  }
  .style--modern .fashion-btn {
    padding: 15px 40px; background: #fff; color: #000; font-weight: 700; border-radius: 4px; text-decoration: none; text-transform: uppercase;
  }
  .style--modern .fashion-btn:hover { background: #000; color: #fff; }

  /* 2. Style : LUXURY SERIF (Vogue, Dior...) */
  .style--luxury .fashion-title {
    font-family: "Playfair Display", "Times New Roman", Times, serif;
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 400;
    font-style: italic;
    letter-spacing: 2px;
    margin-bottom: 20px;
    line-height: 1.1;
  }
  .style--luxury .fashion-text {
    font-family: -apple-system, sans-serif; font-size: 1rem; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 40px;
  }
  .style--luxury .fashion-btn {
    padding: 12px 35px; background: transparent; color: #fff; border: 1px solid #fff; text-decoration: none; letter-spacing: 3px; text-transform: uppercase; font-size: 0.85rem;
  }
  .style--luxury .fashion-btn:hover { background: #fff; color: #000; }

  /* 3. Style : CHICAGO DRILL (Massif, Street) */
  .style--drill .fashion-title {
    font-family: 'Impact', 'Arial Black', sans-serif;
    text-transform: uppercase;
    font-size: clamp(3.5rem, 8vw, 7rem);
    letter-spacing: -2px;
    line-height: 0.9;
    margin-bottom: 15px;
    text-shadow: 4px 4px 15px rgba(0,0,0,0.7);
  }
  .style--drill .fashion-text {
    font-family: inherit; font-size: 1.2rem; font-weight: bold; text-transform: uppercase; margin-bottom: 30px; letter-spacing: 1px;
  }
  .style--drill .fashion-btn {
    padding: 16px 50px; background: #ff0000; /* Touche rouge agressive */ color: #fff; font-weight: 900; text-transform: uppercase; text-decoration: none; font-size: 1.2rem;
  }
  .style--drill .fashion-btn:hover { background: #fff; color: #000; }

  /* 4. Style : Y2K / TECHWEAR (Cyber, Large) */
  .style--y2k .fashion-title {
    font-family: "Courier New", Courier, monospace;
    text-transform: uppercase;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: 8px;
    margin-bottom: 20px;
  }
  .style--y2k .fashion-text {
    font-family: inherit; font-size: 1rem; color: #00ffcc; /* Touche néon */ margin-bottom: 30px; letter-spacing: 2px;
  }
  .style--y2k .fashion-btn {
    padding: 15px 30px; background: transparent; color: #fff; border: 2px solid #00ffcc; text-decoration: none; text-transform: uppercase; font-weight: bold; font-family: inherit;
  }
  .style--y2k .fashion-btn:hover { background: #00ffcc; color: #000; box-shadow: 0 0 15px #00ffcc; }

  /* 5. Style : MINIMALIST EDITORIAL (Espace, Discret) */
  .style--minimalist .fashion-title {
    font-family: -apple-system, sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 300;
    letter-spacing: 15px;
    text-transform: uppercase;
    margin-bottom: 30px;
    margin-left: 15px; /* Compense le letter-spacing */
  }
  .style--minimalist .fashion-text {
    display: none; /* On cache le texte pour le minimalisme pur */
  }
  .style--minimalist .fashion-btn {
    padding: 0; background: none; color: #fff; text-decoration: none; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 4px; border-bottom: 1px solid #fff; padding-bottom: 5px;
  }
  .style--minimalist .fashion-btn:hover { color: #aaa; border-color: #aaa; }


  /* --- Responsive Mobile --- */
  @media (max-width: 768px) {
    .fashion-slider-{{ section.id }} { height: {{ section.settings.mobile_height }}vh; }
    .has-mobile-img .fashion-slide__img--desktop { display: none; }
    .has-mobile-img .fashion-slide__img--mobile { display: block; }
  }
</style>

<div class="fashion-slider-{{ section.id }}" data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}">
  {%- for block in section.blocks -%}
    <div class="fashion-slide {% if forloop.first %}is-active{% endif %} style--{{ block.settings.typography_style }}" {{ block.shopify_attributes }}>
      
      <div class="fashion-slide__images {% if block.settings.image_mobile != blank %}has-mobile-img{% endif %}">
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 3000 }}" alt="{{ block.settings.title | escape }}" class="fashion-slide__img fashion-slide__img--desktop" loading="eager">
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'fashion-slide__img fashion-slide__img--desktop' }}
        {%- endif -%}
        
        {%- if block.settings.image_mobile != blank -%}
          <img src="{{ block.settings.image_mobile | image_url: width: 1000 }}" alt="{{ block.settings.title | escape }}" class="fashion-slide__img fashion-slide__img--mobile" loading="eager">
        {%- endif -%}
      </div>

      <div class="fashion-slide__overlay" style="opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }}"></div>

      <div class="fashion-content">
        {%- if block.settings.title != blank -%}
          <h2 class="fashion-title">{{ block.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <p class="fashion-text">{{ block.settings.text | escape }}</p>
        {%- endif -%}
        {%- if block.settings.btn_label != blank -%}
          <a href="{{ block.settings.btn_link }}" class="fashion-btn">{{ block.settings.btn_label | escape }}</a>
        {%- endif -%}
      </div>

    </div>
  {%- endfor -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sliderContainer = document.querySelector('.fashion-slider-{{ section.id }}');
    const slides = sliderContainer.querySelectorAll('.fashion-slide');
    const speed = sliderContainer.dataset.autoplaySpeed || 5000;
    
    if (slides.length < 2) return;

    let currentSlide = 0;
    const totalSlides = slides.length;

    function nextSlide() {
      slides[currentSlide].classList.remove('is-active');
      currentSlide = (currentSlide + 1) % totalSlides;
      slides[currentSlide].classList.add('is-active');
    }

    setInterval(nextSlide, speed);
  });
</script>

{% schema %}
{
  "name": "Slider Multi-Styles",
  "max_blocks": 5,
  "settings": [
    {
      "type": "range",
      "id": "desktop_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Hauteur sur PC",
      "default": 85
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Hauteur sur Mobile",
      "default": 75
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Vitesse de défilement",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositive",
      "settings": [
        {
          "type": "header",
          "content": "Direction Artistique"
        },
        {
          "type": "select",
          "id": "typography_style",
          "label": "Style Typographique",
          "options": [
            { "value": "modern", "label": "Modern Clean (Prêt-à-porter)" },
            { "value": "luxury", "label": "Luxury Serif (Haute Couture)" },
            { "value": "drill", "label": "Chicago Drill (Streetwear)" },
            { "value": "y2k", "label": "Y2K / Techwear (Futuriste)" },
            { "value": "minimalist", "label": "Minimalist (Éditorial)" }
          ],
          "default": "modern"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 90,
          "step": 10,
          "unit": "%",
          "label": "Opacité du filtre noir",
          "default": 30
        },
        {
          "type": "header",
          "content": "Images"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image PC (Paysage)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image Mobile (Portrait)"
        },
        {
          "type": "header",
          "content": "Textes"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre principal",
          "default": "Nouvelle Collection"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Sous-titre",
          "default": "Découvrez nos dernières pièces."
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Texte du bouton",
          "default": "Acheter"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Lien du bouton"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slider Multi-Styles",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "typography_style": "luxury",
            "title": "L'Élégance Pure",
            "text": "Collection Printemps-Été",
            "overlay_opacity": 20
          }
        },
        {
          "type": "slide",
          "settings": {
            "typography_style": "drill",
            "title": "O'BLOCK VIBES",
            "text": "RAW STREETWEAR NO CAP",
            "overlay_opacity": 50
          }
        },
        {
          "type": "slide",
          "settings": {
            "typography_style": "y2k",
            "title": "SYSTEM OVERRIDE",
            "text": "NEW TECHWEAR DROP",
            "overlay_opacity": 60
          }
        }
      ]
    }
  ]
}
{% endschema %}