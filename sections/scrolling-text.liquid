<style>
  .scrolling-text-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: {{ section.settings.padding_y }}px 0;
    overflow: hidden;
    position: relative;
    display: flex;
    white-space: nowrap;
    border-top: {{ section.settings.border_thickness }}px solid {{ section.settings.border_color }};
    border-bottom: {{ section.settings.border_thickness }}px solid {{ section.settings.border_color }};
  }
  
  .scrolling-text-track {
    display: flex;
    width: max-content;
  }
  
  .scrolling-text-content {
    display: flex;
    align-items: center;
    justify-content: space-around;
    min-width: 100vw;
    /* L'animation fait défiler exactement 100% de sa propre largeur */
    animation: scrollMarquee {{ section.settings.speed }}s linear infinite;
    {%- if section.settings.direction == 'right' -%}
      animation-direction: reverse;
    {%- endif -%}
  }

  /* Mise en pause au survol si activé */
  {%- if section.settings.pause_on_hover -%}
  .scrolling-text-{{ section.id }}:hover .scrolling-text-content {
    animation-play-state: paused;
  }
  {%- endif -%}

  .scrolling-text-item {
    display: flex;
    align-items: center;
    padding: 0 3vw;
    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    text-transform: uppercase;
    letter-spacing: 1.5px;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.3s ease;
  }
  
  a.scrolling-text-item:hover {
    opacity: 0.7;
  }

  .scrolling-text-icon {
    margin-right: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .scrolling-text-icon svg {
    height: {{ section.settings.font_size | times: 1.2 }}px;
    width: auto;
    fill: currentColor;
  }

  @keyframes scrollMarquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }

  @media (max-width: 768px) {
    .scrolling-text-item {
      font-size: {{ section.settings.font_size_mobile }}px;
      padding: 0 5vw;
    }
    .scrolling-text-icon svg {
      height: {{ section.settings.font_size_mobile | times: 1.2 }}px;
    }
  }
</style>

<div class="scrolling-text-{{ section.id }}">
  <div class="scrolling-text-track" role="marquee">
    
    {%- for i in (1..6) -%}
      <div class="scrolling-text-content" aria-hidden="{% if forloop.index > 1 %}true{% else %}false{% endif %}">
        {%- for block in section.blocks -%}
          
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="scrolling-text-item" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="scrolling-text-item" {{ block.shopify_attributes }}>
          {%- endif -%}

            {%- if block.settings.icon != 'none' -%}
              <span class="scrolling-text-icon">
                {%- case block.settings.icon -%}
                  {%- when 'star' -%}
                    <svg viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
                  {%- when 'check' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  {%- when 'lightning' -%}
                    <svg viewBox="0 0 24 24"><path d="M13 2L3 14H12L11 22L21 10H12L13 2Z"/></svg>
                {%- endcase -%}
              </span>
            {%- endif -%}

            {{ block.settings.text | escape }}

          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}

        {%- endfor -%}
      </div>
    {%- endfor -%}
    
  </div>
</div>

{% schema %}
{
  "name": "Barre défilante",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 40,
      "step": 1,
      "unit": "s",
      "label": "Vitesse de défilement",
      "default": 15
    },
    {
      "type": "select",
      "id": "direction",
      "options": [
        { "value": "left", "label": "Vers la gauche" },
        { "value": "right", "label": "Vers la droite" }
      ],
      "default": "left",
      "label": "Direction du défilement"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Mettre en pause au survol",
      "default": true
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Taille de police (Bureau)",
      "default": 14
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Taille de police (Mobile)",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "600", "label": "Semi-Gras" },
        { "value": "800", "label": "Gras" }
      ],
      "default": "600",
      "label": "Graisse de la police"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Espacement vertical",
      "default": 10
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Couleur de la bordure",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Épaisseur de la bordure",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Livraison gratuite à partir de 50€"
        },
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "none", "label": "Aucune" },
            { "value": "star", "label": "Étoile" },
            { "value": "check", "label": "Validation" },
            { "value": "lightning", "label": "Éclair" }
          ],
          "default": "star",
          "label": "Icône décorative"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (Optionnel)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre défilante",
      "blocks": [
        { "type": "text", "settings": { "text": "Livraison Express 48h", "icon": "lightning" } },
        { "type": "text", "settings": { "text": "Paiement 100% Sécurisé", "icon": "check" } },
        { "type": "text", "settings": { "text": "Retours gratuits sous 30 jours", "icon": "star" } }
      ]
    }
  ]
}
{% endschema %}