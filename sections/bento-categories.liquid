<style>
  .bento-section-{{ section.id }} {
    padding: 20px 5% 60px 5%;
    max-width: 1400px;
    margin: 0 auto;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  /* Le grand conteneur gris aux bords très arrondis */
  .bento-container {
    background-color: {{ section.settings.bg_color }};
    border-radius: 40px;
    padding: 60px;
    text-align: center;
  }

  .bento-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: #000000;
    text-transform: uppercase;
    margin: 0 0 50px 0;
    letter-spacing: -1px;
  }

  /* La grille asymétrique */
  .bento-grid {
    display: grid;
    /* On divise en 3 colonnes pour faire le ratio 1/3 - 2/3 */
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .bento-card {
    background-color: #ffffff;
    border-radius: 20px;
    position: relative;
    height: 280px;
    overflow: hidden;
    display: block;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .bento-card:hover {
    transform: scale(1.02);
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  }

  /* Titre en haut à gauche de la carte */
  .bento-card__title {
    position: absolute;
    top: 25px;
    left: 30px;
    font-size: 1.8rem;
    font-weight: 800;
    color: #000000;
    margin: 0;
    z-index: 2;
  }

  /* Image positionnée sur la droite */
  .bento-card__image {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center; /* Garde le focus sur la droite de l'image */
    z-index: 1;
    transition: transform 0.5s ease;
  }

  .bento-card:hover .bento-card__image {
    transform: scale(1.05); /* Léger zoom de l'image au survol */
  }

  /* --- Gestion de l'asymétrie --- */
  /* Block 1 (Petit) */
  .bento-card:nth-child(1) { grid-column: span 1; }
  /* Block 2 (Grand) */
  .bento-card:nth-child(2) { grid-column: span 2; }
  /* Block 3 (Grand) */
  .bento-card:nth-child(3) { grid-column: span 2; }
  /* Block 4 (Petit) */
  .bento-card:nth-child(4) { grid-column: span 1; }

  /* --- Responsive Mobile --- */
  @media (max-width: 900px) {
    .bento-container {
      padding: 40px 20px;
      border-radius: 24px;
    }
    .bento-grid {
      grid-template-columns: 1fr; /* 1 seule colonne sur mobile */
      gap: 16px;
    }
    /* Sur mobile, toutes les cartes font la même largeur */
    .bento-card:nth-child(1),
    .bento-card:nth-child(2),
    .bento-card:nth-child(3),
    .bento-card:nth-child(4) {
      grid-column: span 1;
    }
    .bento-card {
      height: 200px; /* Moins haut sur téléphone */
    }
    .bento-card__title {
      font-size: 1.5rem;
      top: 20px;
      left: 20px;
    }
  }
</style>

<div class="bento-section-{{ section.id }}">
  <div class="bento-container">
    
    {%- if section.settings.title != blank -%}
      <h2 class="bento-title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}

    <div class="bento-grid">
      {%- for block in section.blocks limit: 4 -%}
        <a href="{{ block.settings.link }}" class="bento-card" {{ block.shopify_attributes }}>
          
          <h3 class="bento-card__title">{{ block.settings.title | escape }}</h3>
          
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 1000 }}" 
                 alt="{{ block.settings.title | escape }}" 
                 class="bento-card__image"
                 loading="lazy">
          {%- else -%}
            <div class="bento-card__image" style="background-color: #f8f8f8; display: flex; align-items: center; justify-content: center;">
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}

        </a>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Catégories Style Bento",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre principal",
      "default": "BROWSE BY DRESS STYLE"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur du grand conteneur",
      "default": "#F0F0F0",
      "info": "Gris très clair recommandé."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Catégorie",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nom de la catégorie",
          "default": "Casual"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien de la catégorie"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Utilisez des images de mannequins avec fond blanc ou PNG transparent pour un rendu optimal."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Catégories Style Bento",
      "blocks": [
        { "type": "category", "settings": { "title": "Casual" } },
        { "type": "category", "settings": { "title": "Formal" } },
        { "type": "category", "settings": { "title": "Party" } },
        { "type": "category", "settings": { "title": "Gym" } }
      ]
    }
  ]
}
{% endschema %}