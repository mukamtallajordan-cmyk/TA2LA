<style>
  .standard-page {
    /* Une largeur restreinte (800px) est le standard du web pour une lecture confortable */
    max-width: 800px; 
    margin: 0 auto;
    padding: 80px 5%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  /* --- Titre Principal de la page --- */
  .standard-page__title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    color: #000000;
    text-align: center;
    margin: 0 0 50px 0;
    text-transform: uppercase;
    letter-spacing: -1px;
    line-height: 1.1;
  }

  /* --- Contenu (Le texte tapé dans l'éditeur Shopify) --- */
  .standard-page__content {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #333333;
  }

  /* Sous-titres (H2, H3, etc.) créés dans l'éditeur */
  .standard-page__content h2 {
    font-size: 1.8rem;
    font-weight: 800;
    color: #000000;
    margin: 50px 0 20px 0;
    letter-spacing: -0.5px;
  }

  .standard-page__content h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #111111;
    margin: 40px 0 15px 0;
  }

  .standard-page__content h4 {
    font-size: 1.2rem;
    font-weight: 600;
    color: #222222;
    margin: 30px 0 15px 0;
  }

  /* Paragraphes */
  .standard-page__content p {
    margin-bottom: 25px;
  }

  /* Liens cliquables dans le texte */
  .standard-page__content a {
    color: #000000;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .standard-page__content a:hover {
    opacity: 0.6;
  }

  /* Listes à puces et numérotées */
  .standard-page__content ul, 
  .standard-page__content ol {
    margin-bottom: 25px;
    padding-left: 20px;
  }

  .standard-page__content li {
    margin-bottom: 10px;
  }

  /* Tableaux (Souvent utilisés pour les guides des tailles) */
  .standard-page__content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 30px;
  }

  .standard-page__content th, 
  .standard-page__content td {
    padding: 15px;
    border: 1px solid #E2E8F0;
    text-align: left;
  }

  .standard-page__content th {
    background-color: #F8FAFC;
    font-weight: 700;
    color: #000;
  }

  /* --- Responsive Mobile --- */
  @media (max-width: 768px) {
    .standard-page {
      padding: 50px 5%;
    }
    .standard-page__title {
      margin-bottom: 30px;
    }
    .standard-page__content {
      font-size: 1.05rem;
    }
    .standard-page__content h2 {
      margin: 40px 0 15px 0;
    }
  }
</style>

<div class="standard-page">
  <h1 class="standard-page__title">{{ page.title | escape }}</h1>
  
  <div class="standard-page__content">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "Page de contenu",
  "settings": []
}
{% endschema %}