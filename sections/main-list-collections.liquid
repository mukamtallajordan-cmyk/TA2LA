<style>
  .list-collections {
    padding: 60px 5%;
    max-width: 1400px;
    margin: 0 auto;
  }
  
  .list-collections__title {
    text-align: center;
    font-size: 2.5rem;
    color: var(--color-primary);
    margin-bottom: 50px;
    font-weight: bold;
  }
  
  .list-collections__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
  }
  
  .collection-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }
  
  .collection-card:hover {
    transform: translateY(-5px);
  }
  
  .collection-card__image-wrapper {
    position: relative;
    padding-top: 100%; /* Crée un format Carré 1:1 parfait */
    background-color: #f4f4f4;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 20px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }
  
  .collection-card__image, .placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  
  .collection-card:hover .collection-card__image {
    transform: scale(1.05);
  }
  
  .collection-card__info {
    text-align: center;
  }
  
  .collection-card__title {
    font-size: 1.3rem;
    font-weight: bold;
    margin: 0 0 5px;
    color: var(--color-primary);
  }
  
  .collection-card__count {
    font-size: 0.95rem;
    color: #666;
  }
  
  /* --- Responsive Mobile --- */
  @media (max-width: 768px) {
    .list-collections__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: 20px;
    }
    .list-collections__title {
      font-size: 2rem;
      margin-bottom: 30px;
    }
  }
</style>

<div class="list-collections">
  <h1 class="list-collections__title">{{ section.settings.title | escape }}</h1>

  <div class="list-collections__grid">
    {%- for collection in collections -%}
      
      {%- if collection.handle != 'frontpage' or collection.products_count > 0 -%}
        
        <a href="{{ collection.url }}" class="collection-card">
          <div class="collection-card__image-wrapper">
            
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | image_url: width: 800 }}" 
                   alt="{{ collection.title | escape }}" 
                   class="collection-card__image"
                   width="800"
                   height="800"
                   loading="lazy">
            {%- elsif collection.products.first and collection.products.first.featured_image -%}
              <img src="{{ collection.products.first.featured_image | image_url: width: 800 }}" 
                   alt="{{ collection.title | escape }}" 
                   class="collection-card__image"
                   width="800"
                   height="800"
                   loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}

          </div>
          
          <div class="collection-card__info">
            <h2 class="collection-card__title">{{ collection.title }}</h2>
            <span class="collection-card__count">{{ collection.products_count }} produit{% if collection.products_count > 1 %}s{% endif %}</span>
          </div>
        </a>

      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Liste des collections",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre de la page",
      "default": "Toutes nos collections"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "Colonnes sur ordinateur"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1 par ligne" },
        { "value": "2", "label": "2 par ligne" }
      ],
      "default": "1",
      "label": "Colonnes sur mobile"
    }
  ]
}
{% endschema %}