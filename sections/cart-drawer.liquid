<div class="drawer-overlay" id="CartDrawerOverlay"></div>

<div class="cart-drawer" id="CartDrawer">
  <div class="cart-drawer-inner" id="CartDrawerContent">
    
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">Ton Panier ({{ cart.item_count }})</h2>
      <button class="cart-drawer__close" id="CloseCartDrawer" aria-label="Fermer">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div class="cart-drawer__body">
      {%- if cart == empty -%}
        <div class="cart-drawer__empty">
          <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="#ccc" stroke-width="1.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
          <p>Ton panier est actuellement vide.</p>
          <button class="cart-drawer__btn-shop" onclick="document.getElementById('CloseCartDrawer').click();">Continuer mes achats</button>
        </div>
      {%- else -%}
        <div class="cart-drawer__items">
          {%- for item in cart.items -%}
            <div class="cart-drawer__item">
              
              <div class="cart-drawer__item-img">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 400 }}" alt="{{ item.title | escape }}">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
              
              <div class="cart-drawer__item-details">
                <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <span class="cart-drawer__item-price">{{ item.final_line_price | money }}</span>
                
                <div class="cart-drawer__qty-wrap">
                  <div class="cart-drawer__qty">
                    <button type="button" class="drawer-qty-btn drawer-qty-minus" data-key="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}">-</button>
                    <input type="text" value="{{ item.quantity }}" readonly>
                    <button type="button" class="drawer-qty-btn drawer-qty-plus" data-key="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}">+</button>
                  </div>
                  <button type="button" class="cart-drawer__remove drawer-qty-btn" data-key="{{ item.key }}" data-qty="0">Retirer</button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if cart != empty -%}
      <div class="cart-drawer__footer">
        <div class="cart-drawer__subtotal">
          <span>Sous-total</span>
          <strong>{{ cart.total_price | money }}</strong>
        </div>
        <p class="cart-drawer__tax-note">Taxes et frais de port calculés à l'étape de paiement.</p>
        
        <form action="{{ routes.cart_url }}" method="post" id="cart">
          <button type="submit" name="checkout" class="cart-drawer__checkout">
            Passer à la caisse
          </button>
        </form>
        <a href="{{ routes.cart_url }}" class="cart-drawer__view-cart">Voir le panier complet</a>
      </div>
    {%- endif -%}
    
  </div>
</div>

<style>
  /* --- Styles du Tiroir --- */
  .drawer-overlay {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
    background: rgba(0,0,0,0.6); z-index: 10000;
    opacity: 0; visibility: hidden; transition: opacity 0.3s ease;
  }
  .drawer-overlay.is-active { opacity: 1; visibility: visible; }

  .cart-drawer {
    position: fixed; top: 0; right: -100%; width: 100%; max-width: 420px; height: 100vh;
    background: #fff; z-index: 10001; transition: right 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    box-shadow: -5px 0 30px rgba(0,0,0,0.1);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  }
  .cart-drawer.is-open { right: 0; }

  .cart-drawer-inner {
    display: flex; flex-direction: column; height: 100%;
  }

  /* Header */
  .cart-drawer__header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px 25px; border-bottom: 1px solid #eee; background: #fff;
  }
  .cart-drawer__title { font-size: 1.2rem; font-weight: 900; margin: 0; text-transform: uppercase; letter-spacing: -0.5px;}
  .cart-drawer__close { background: none; border: none; cursor: pointer; color: #000; padding: 5px; }

  /* Body */
  .cart-drawer__body {
    flex-grow: 1; overflow-y: auto; padding: 25px;
    /* Custom Scrollbar */
    scrollbar-width: thin; scrollbar-color: #ccc transparent;
  }
  .cart-drawer__body::-webkit-scrollbar { width: 6px; }
  .cart-drawer__body::-webkit-scrollbar-thumb { background-color: #ccc; border-radius: 10px; }

  /* Empty State */
  .cart-drawer__empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    height: 100%; text-align: center; color: #666; gap: 15px;
  }
  .cart-drawer__btn-shop {
    background: #000; color: #fff; border: none; padding: 12px 30px; border-radius: 50px;
    font-weight: 700; cursor: pointer; margin-top: 10px;
  }

  /* Items */
  .cart-drawer__items { display: flex; flex-direction: column; gap: 25px; }
  .cart-drawer__item { display: flex; gap: 15px; }
  
  .cart-drawer__item-img {
    width: 90px; height: 110px; flex-shrink: 0;
    background: #f4f4f4; border-radius: 10px; overflow: hidden;
  }
  .cart-drawer__item-img img { width: 100%; height: 100%; object-fit: cover; }

  .cart-drawer__item-details { display: flex; flex-direction: column; flex-grow: 1; }
  .cart-drawer__item-title { font-weight: 800; color: #000; text-decoration: none; font-size: 1rem; line-height: 1.2; margin-bottom: 5px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;}
  .cart-drawer__item-variant { font-size: 0.85rem; color: #666; margin: 0 0 5px 0; }
  .cart-drawer__item-price { font-weight: 700; color: #000; font-size: 1.1rem; margin-bottom: 10px;}

  .cart-drawer__qty-wrap { display: flex; justify-content: space-between; align-items: center; margin-top: auto;}
  .cart-drawer__qty {
    display: flex; align-items: center; background: #F0F0F0; border-radius: 50px; height: 35px;
  }
  .cart-drawer__qty button {
    background: none; border: none; width: 30px; font-weight: 600; cursor: pointer; font-size: 1.2rem;
  }
  .cart-drawer__qty input {
    width: 30px; text-align: center; background: transparent; border: none; font-weight: 700; pointer-events: none;
  }
  .cart-drawer__remove {
    background: none; border: none; color: #666; text-decoration: underline; font-size: 0.85rem; cursor: pointer;
  }

  /* Footer */
  .cart-drawer__footer {
    padding: 25px; border-top: 1px solid #eee; background: #f9f9f9;
  }
  .cart-drawer__subtotal {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 1.2rem; margin-bottom: 10px;
  }
  .cart-drawer__subtotal strong { font-size: 1.4rem; font-weight: 900; }
  .cart-drawer__tax-note { font-size: 0.85rem; color: #666; margin: 0 0 20px 0; }
  
  .cart-drawer__checkout {
    width: 100%; background: #000; color: #fff; border: none; padding: 16px;
    border-radius: 50px; font-size: 1.1rem; font-weight: 800; cursor: pointer;
    transition: background 0.2s;
  }
  .cart-drawer__checkout:hover { background: #333; }
  
  .cart-drawer__view-cart {
    display: block; text-align: center; margin-top: 15px; color: #000;
    font-weight: 600; text-decoration: underline; font-size: 0.95rem;
  }

  /* Loader d'ajout */
  .is-loading { opacity: 0.5; pointer-events: none; }
</style>

<script>
  function initCartDrawer() {
    if (window.CartDrawerInitialized) return;
    window.CartDrawerInitialized = true;

    const drawer = document.getElementById('CartDrawer');
    const overlay = document.getElementById('CartDrawerOverlay');
    
    if (!drawer || !overlay) return;

    window.openCartDrawer = function() {
      drawer.classList.add('is-open');
      overlay.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    };

    window.closeCartDrawer = function() {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-active');
      document.body.style.overflow = '';
    };

    document.addEventListener('click', (e) => {
      // 1. Gérer la fermeture
      if (e.target.closest('#CloseCartDrawer') || e.target === overlay) {
        closeCartDrawer();
      }
      
      // 2. Intercepter l'ouverture depuis n'importe quel lien pointant vers le panier
      // L'astuce ici est le *= qui signifie "contient /cart", évitant les bugs liés aux langues (/fr/cart)
      const cartLink = e.target.closest('a[href*="/cart"]');
      if (cartLink && !window.location.pathname.endsWith('/cart')) {
        e.preventDefault();
        openCartDrawer();
      }

      // 3. Intercepter les boutons + et - dans le tiroir
      if (e.target.matches('.drawer-qty-btn')) {
        e.preventDefault();
        const btn = e.target;
        const key = btn.dataset.key;
        const qty = btn.dataset.qty;
        
        document.getElementById('CartDrawerContent').classList.add('is-loading');

        fetch(window.Shopify.routes.root + 'cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: key, quantity: qty })
        })
        .then(response => response.json())
        .then(data => {
          updateCartDrawer(true);
        });
      }
    });

    // 4. Intercepter l'ajout au panier
    document.addEventListener('submit', function(e) {
      if (e.target.matches('form[action*="/cart/add"]')) {
        e.preventDefault();
        
        const form = e.target;
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn ? submitBtn.innerHTML : '';
        
        if(submitBtn) {
          submitBtn.classList.add('is-loading');
          submitBtn.innerHTML = 'Ajout en cours...';
        }

        const formData = new FormData(form);

        fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          body: formData
        })
        .then(response => response.json())
        .then(data => {
          updateCartDrawer();
          if(submitBtn) {
            submitBtn.classList.remove('is-loading');
            submitBtn.innerHTML = originalText;
          }
        })
        .catch((error) => {
          console.error('Erreur:', error);
          if(submitBtn) {
            submitBtn.classList.remove('is-loading');
            submitBtn.innerHTML = originalText;
          }
        });
      }
    });

    // 5. Mettre à jour le tiroir HTML
    window.updateCartDrawer = function(keepOpen = false) {
      fetch(window.location.pathname + '?sections=cart-drawer')
      .then(res => res.json())
      .then(data => {
        const parser = new DOMParser();
        const htmlDoc = parser.parseFromString(data['cart-drawer'], 'text/html');
        
        const newContent = htmlDoc.getElementById('CartDrawerContent').innerHTML;
        document.getElementById('CartDrawerContent').innerHTML = newContent;
        
        document.getElementById('CartDrawerContent').classList.remove('is-loading');

        updateCartBubble();

        if (!keepOpen) {
          openCartDrawer();
        }
      });
    }

    // 6. Mettre à jour la petite bulle avec le chiffre
    function updateCartBubble() {
      fetch(window.Shopify.routes.root + 'cart.js')
      .then(res => res.json())
      .then(cart => {
        const bubbles = document.querySelectorAll('.cart-count-bubble');
        bubbles.forEach(bubble => {
          bubble.textContent = cart.item_count;
          bubble.style.display = cart.item_count > 0 ? 'flex' : 'none';
        });
      });
    }
  }

  // Lancement robuste, que le DOM soit déjà chargé ou non
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCartDrawer);
  } else {
    initCartDrawer();
  }
</script>

{% schema %}
{
  "name": "Tiroir Panier AJAX",
  "settings": []
}
{% endschema %}