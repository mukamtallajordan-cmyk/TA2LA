<style>
  .faq-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: 80px 5%;
  }

  .faq-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .faq__header {
    text-align: center;
    margin-bottom: 50px;
  }

  .faq__title {
    font-size: 2.5rem;
    color: var(--color-primary);
    margin: 0;
    font-weight: bold;
  }

  .faq__description {
    font-size: 1.1rem;
    color: #555;
    margin-top: 15px;
  }

  /* --- Styles de l'accordéon (Sans JavaScript) --- */
  .faq-item {
    border-bottom: 1px solid #E5E5E5;
    /* Arrondir le haut et le bas si on veut un style de carte, ici on fait des lignes épurées */
  }

  .faq-item:first-of-type {
    border-top: 1px solid #E5E5E5;
  }

  /* Cache la flèche par défaut du navigateur */
  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question {
    list-style: none;
    padding: 25px 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.3s ease;
  }

  .faq-question:hover {
    color: var(--color-button);
  }

  /* L'icône Plus/Croix */
  .faq-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    position: relative;
    margin-left: 20px;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    background-color: currentColor;
    transition: transform 0.3s ease;
  }

  /* Ligne horizontale */
  .faq-icon::before {
    top: 11px;
    left: 0;
    width: 24px;
    height: 2px;
  }

  /* Ligne verticale */
  .faq-icon::after {
    top: 0;
    left: 11px;
    width: 2px;
    height: 24px;
  }

  /* Animation quand la FAQ est ouverte */
  details[open] .faq-question {
    color: var(--color-button);
  }

  details[open] .faq-icon::after {
    transform: rotate(90deg);
  }

  .faq-answer {
    padding-bottom: 25px;
    padding-right: 40px;
    color: #444;
    line-height: 1.6;
    font-size: 1.05rem;
    animation: fadeDown 0.4s ease-out forwards;
  }

  .faq-answer p {
    margin: 0 0 10px 0;
  }

  .faq-answer p:last-child {
    margin-bottom: 0;
  }

  .faq-answer a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  @keyframes fadeDown {
    0% {
      opacity: 0;
      transform: translateY(-10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .faq-section-{{ section.id }} {
      padding: 50px 5%;
    }
    .faq__title {
      font-size: 2rem;
    }
    .faq-question {
      font-size: 1.1rem;
      padding: 20px 0;
    }
  }
</style>

<div class="faq-section-{{ section.id }}">
  <div class="faq-container">
    <div class="faq__header">
      {%- if section.settings.title != blank -%}
        <h2 class="faq__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="faq__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    <div class="faq__accordion">
      {%- for block in section.blocks -%}
        <details class="faq-item" {{ block.shopify_attributes }}>
          <summary class="faq-question">
            {{ block.settings.question | escape }}
            <span class="faq-icon"></span>
          </summary>
          <div class="faq-answer">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Foire Aux Questions",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre principal",
      "default": "Foire Aux Questions"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Sous-titre (optionnel)",
      "default": "Vous avez des questions ? Nous avons les réponses."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question / Réponse",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Quels sont les délais de livraison ?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Nos délais de livraison standard sont de 3 à 5 jours ouvrés. Vous recevrez un numéro de suivi dès que votre commande sera expédiée.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Foire Aux Questions",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Quels sont les délais de livraison ?",
            "answer": "<p>Nos délais de livraison standard sont de 3 à 5 jours ouvrés. Vous recevrez un numéro de suivi dès que votre commande sera expédiée.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Acceptez-vous les retours ?",
            "answer": "<p>Oui, nous acceptons les retours dans un délai de 30 jours après réception de votre commande, à condition que le produit n'ait pas été utilisé.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Quels moyens de paiement sont sécurisés ?",
            "answer": "<p>Nous acceptons les cartes Visa, Mastercard, American Express ainsi que PayPal et Apple Pay. Tous nos paiements sont 100% sécurisés et cryptés.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}